<!DOCTYPE html>
<html lang="es">
<% const isC = mode === 'carrusel'; %>
<head><%- include('../../partials/head', { title: isC ? 'Carrusel del inicio' : 'Anuncios' }) %></head>
<body>
  <%- include('../../partials/nav', { path: path }) %>
  <div class="page">
    <h1><%= isC ? 'Carrusel del inicio' : 'Anuncios' %></h1>
    <p class="muted" style="margin:-.75rem 0 1.25rem">
      <% if (isC) { %>Fotos del carrusel del inicio (se recortan a 4:3). Mientras no haya fotos activas aquí, el inicio muestra automáticamente fotos de los productos.<% } else { %>Mensajes de la barra superior y de la ventana emergente.<% } %>
    </p>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="alert alert-success"><%= success %></div>
    <% } %>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;align-items:start">

      <!-- form -->
      <div class="card">
        <h2><%= editing ? (isC ? 'Editar foto' : 'Editar anuncio') : (isC ? 'Nueva foto del carrusel' : 'Nuevo anuncio') %></h2>
        <form method="POST" action="<%= editing ? '/admin/announcements/' + editing._id : '/admin/announcements' %>" enctype="multipart/form-data">
          <% const isCarousel = editing ? editing.placement === 'carrusel' : isC; %>
          <div class="form-group">
            <label for="placement">Dónde se muestra</label>
            <select name="placement" id="placement">
              <option value="anuncio" <%= isCarousel ? '' : 'selected' %>>Anuncio (barra superior y ventana emergente)</option>
              <option value="carrusel" <%= isCarousel ? 'selected' : '' %>>Carrusel del inicio (foto de producto)</option>
            </select>
            <span class="hint" id="placementHint">Las imágenes del carrusel se recortan a 4:3 (1200×900), centradas en lo importante. Sube fotos de al menos 1200 px de ancho.</span>
          </div>
          <div class="form-group">
            <label>Título *</label>
            <input type="text" name="title" required value="<%= editing ? editing.title : '' %>" />
          </div>
          <div class="form-group" id="messageGroup">
            <label>Mensaje *</label>
            <textarea name="message" id="message" required><%= editing ? editing.message : '' %></textarea>
          </div>
          <div class="form-group">
            <label>Imagen <%= editing ? '' : '*' %></label>
            <% if (editing && editing.image) { %>
              <img src="<%= isCarousel ? editing.image.replace('/upload/', '/upload/c_fill,g_auto,ar_4:3,w_600,f_auto,q_auto/') : editing.image %>" alt="" style="width:100%;<%= isCarousel ? 'aspect-ratio:4/3' : 'max-height:140px' %>;object-fit:cover;border-radius:8px;margin-bottom:.5rem;display:block" />
              <span class="hint">Sube una nueva imagen solo si deseas reemplazar la actual.</span>
            <% } %>
            <input type="file" name="image" accept="image/jpeg,image/jpg,image/png,image/webp,image/gif" <%= editing ? '' : 'required' %> />
            <span class="hint">jpeg, png, webp, gif · máx. 5 MB · se muestra a pantalla completa, requerida para que el anuncio sea visible.</span>
          </div>
          <div class="form-group">
            <label>Orden</label>
            <input type="number" name="order" value="<%= editing ? editing.order : 0 %>" min="0" />
            <span class="hint">Menor número aparece primero en el carrusel.</span>
          </div>
          <div class="form-group">
            <label>Estado</label>
            <div class="check-row">
              <input type="checkbox" name="status" id="status" value="true" <%= (!editing || editing.status) ? 'checked' : '' %> />
              <label for="status" style="text-transform:none;letter-spacing:0;font-size:.9rem;color:#333">Activo (visible en la web)</label>
            </div>
          </div>
          <div style="display:flex;gap:.75rem">
            <button class="btn btn-primary" type="submit"><%= editing ? 'Guardar cambios' : (isC ? 'Agregar al carrusel' : 'Crear anuncio') %></button>
            <% if (editing) { %>
              <a class="btn btn-outline" href="<%= path %>">Cancelar</a>
            <% } %>
          </div>
        </form>
      </div>

      <!-- list -->
      <div class="card">
        <h2><%= isC ? 'Fotos del carrusel' : 'Anuncios registrados' %> (<%= announcements.length %>)</h2>
        <% if (!announcements.length) { %>
          <p style="font-size:.875rem;color:#888"><%= isC ? 'Aún no hay fotos: el inicio está mostrando fotos de productos.' : 'No hay anuncios todavía.' %></p>
        <% } else { %>
          <div style="display:flex;flex-direction:column;gap:.75rem">
            <% announcements.forEach(a => { %>
            <div style="border:1px solid #e5e5e5;border-radius:8px;overflow:hidden">
              <% if (a.image) { %>
                <div style="position:relative">
                  <img src="<%= a.placement === 'carrusel' ? a.image.replace('/upload/', '/upload/c_fill,g_auto,ar_4:3,w_600,f_auto,q_auto/') : a.image %>" alt="<%= a.title %>" style="width:100%;<%= a.placement === 'carrusel' ? 'aspect-ratio:4/3' : 'height:120px' %>;object-fit:cover;display:block" />
                  <% if (a.placement === 'carrusel') { %><span style="position:absolute;top:.5rem;right:.5rem;font-size:.7rem;font-weight:700;padding:.2rem .5rem;border-radius:4px;background:var(--sage);color:#2F3A28">Carrusel</span><% } %>
                  <span style="position:absolute;top:.5rem;left:.5rem;font-size:.7rem;font-weight:600;padding:.2rem .5rem;border-radius:4px;background:#0005;color:#fff">
                    #<%= a.order %>
                  </span>
                </div>
              <% } %>
              <div style="padding:.9rem 1rem 0">
              <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:.5rem">
                <div>
                  <div style="font-weight:500;font-size:.9rem"><%= a.title %></div>
                  <div style="font-size:.8rem;color:#666;margin-top:.2rem"><%= a.message %></div>
                </div>
                <span style="flex-shrink:0;font-size:.7rem;font-weight:500;padding:.2rem .5rem;border-radius:4px;
                  background:<%= a.status ? '#f0fdf4' : '#f5f5f5' %>;
                  color:<%= a.status ? '#15803d' : '#888' %>;
                  border:1px solid <%= a.status ? '#86efac' : '#ddd' %>">
                  <%= a.status ? 'Activo' : 'Inactivo' %>
                </span>
              </div>
              <div style="display:flex;gap:.5rem;margin:.75rem 0 .9rem">
                <a class="btn btn-sm" style="background:#f5f5f5;border:1px solid #e5e5e5" href="/admin/announcements/<%= a._id %>/edit">Editar</a>
                <form method="POST" action="/admin/announcements/<%= a._id %>/toggle" style="margin:0">
                  <button class="btn btn-sm" style="background:#f5f5f5;border:1px solid #e5e5e5" type="submit">
                    <%= a.status ? 'Desactivar' : 'Activar' %>
                  </button>
                </form>
                <form method="POST" action="/admin/announcements/<%= a._id %>/delete" style="margin:0">
                  <button class="btn btn-sm" style="background:#fef2f2;border:1px solid #fca5a5;color:#b91c1c" type="submit"
                    onclick="return confirm('¿Eliminar este anuncio?')">Eliminar</button>
                </form>
              </div>
              </div>
            </div>
            <% }) %>
          </div>
        <% } %>
      </div>

    </div>
  </div>
<script>
  (function () {
    const sel = document.getElementById('placement'), msg = document.getElementById('message');
    const group = document.getElementById('messageGroup'), hint = document.getElementById('placementHint');
    const file = document.querySelector('input[name=image]');
    let preview = null;
    function sync() {
      const c = sel.value === 'carrusel';
      group.style.display = c ? 'none' : '';
      msg.required = !c;
      hint.style.display = c ? '' : 'none';
      if (preview) preview.style.aspectRatio = c ? '4/3' : 'auto';
    }
    sel.addEventListener('change', sync);
    file.addEventListener('change', () => {
      if (!file.files[0]) return;
      if (!preview) {
        preview = document.createElement('img');
        preview.alt = 'Vista previa';
        preview.style.cssText = 'width:100%;object-fit:cover;border-radius:8px;margin-top:.5rem;display:block';
        file.after(preview);
      }
      preview.src = URL.createObjectURL(file.files[0]);
      sync();
    });
    sync();
  })();
</script>
</body>
</html>
