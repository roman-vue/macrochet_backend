<!DOCTYPE html>
<html lang="es">
<head><%- include('../../partials/head', { title: 'Construir cotización' }) %>
<style>
  .builder { display: flex; flex-wrap: wrap; gap: 28px; align-items: flex-start; }
  .builder form { flex: 1 1 380px; max-width: 460px; min-width: 0; display: flex; flex-direction: column; gap: 18px; }
  .builder .card { padding: 22px; }
  .builder h2 { font-size: 1.3rem; margin-bottom: .8rem; }
  .preview { flex: 999 1 520px; min-width: 0; position: sticky; top: 16px; }
  .preview iframe { width: 100%; height: min(86vh, 1000px); border: 1px solid var(--border); border-radius: 8px; background: #fff; box-shadow: 0 10px 30px rgba(74,58,42,.16); }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 12px; }
  .chips button { min-height: 44px; padding: 0 14px 0 6px; border-radius: 999px; border: 1px solid var(--sage); background: var(--cream); color: var(--ink); font: inherit; font-size: 13px; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; }
  .chips button:hover { border-color: var(--wine); }
  .chips img, .line img, .line .ph { width: 32px; height: 32px; border-radius: 999px; object-fit: cover; background: var(--panel-2); }
  .line { display: flex; align-items: center; gap: 10px; padding: 10px 0; border-top: 1px solid #DDD7C0; }
  .line img, .line .ph { width: 44px; height: 44px; border-radius: 8px; flex: none; }
  .line .name { flex: 1; min-width: 0; font-family: 'Playfair Display', serif; font-weight: 700; font-size: 15px; line-height: 1.25; }
  .line input.price { width: 110px; min-height: 40px; padding: .3rem .5rem; }
  .stepper { display: flex; align-items: center; border: 1px solid var(--border); border-radius: 10px; background: var(--cream); }
  .stepper button { width: 40px; height: 40px; border: none; background: none; font-size: 18px; cursor: pointer; color: var(--ink); }
  .stepper span { min-width: 20px; text-align: center; font-weight: 700; }
  .grid-2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .totals { display: flex; justify-content: space-between; font-weight: 700; padding-top: 10px; border-top: 1px solid var(--border); }
  #sharePanel { display: none; }
</style>
</head>
<body>
  <%- include('../../partials/nav', { path: '/admin/quotes' }) %>
  <div class="page-wide">
    <p style="margin-bottom:8px"><a href="/admin/quotes" class="muted">← Cotizaciones</a></p>
    <div style="display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12px;margin-bottom:24px">
      <div>
        <h1 style="margin:0">Construir cotización <span id="qnum" class="muted" style="font-size:1.4rem"><%= quote ? 'N.º ' + quote.number : '' %></span></h1>
        <p class="muted" style="margin-top:4px">La vista previa del PDF se actualiza al instante.</p>
      </div>
      <div style="display:flex;gap:10px;flex-wrap:wrap">
        <button type="button" class="btn btn-outline" id="btnSave">Guardar borrador</button>
        <button type="button" class="btn btn-green" id="btnSend">Enviar por WhatsApp</button>
        <button type="button" class="btn btn-primary" id="btnPdf">Descargar PDF</button>
      </div>
    </div>
    <div id="msg" role="status" aria-live="polite"></div>
    <div id="sharePanel" class="alert alert-success">
      PDF listo. <button type="button" class="btn btn-sm btn-green" id="btnShare">Compartir PDF por WhatsApp</button>
      <a class="btn btn-sm btn-outline" id="lnkWa" target="_blank" rel="noopener">Abrir chat con enlace</a>
    </div>

    <div class="builder">
      <form id="form" onsubmit="return false">
        <section class="card">
          <h2>Cliente</h2>
          <div class="form-group"><label for="cName">Nombre</label><input id="cName" type="text" maxlength="80" /></div>
          <div class="grid-2">
            <div class="form-group"><label for="cCity">Ciudad</label><input id="cCity" type="text" maxlength="60" /></div>
            <div class="form-group"><label for="cPhone">Celular</label><input id="cPhone" type="tel" maxlength="20" /></div>
          </div>
        </section>

        <section class="card">
          <h2>Productos</h2>
          <p class="hint" style="margin-bottom:10px">Toca un producto para agregarlo. Puedes editar el precio de cada línea.</p>
          <div class="form-group" style="margin-bottom:10px"><label for="search">Buscar</label><input id="search" type="text" placeholder="Nombre del producto" /></div>
          <div class="chips" id="chips"></div>
          <div id="lines"></div>
          <div class="totals"><span>Subtotal</span><span id="subtotal">$0</span></div>
        </section>

        <section class="card">
          <h2>Condiciones</h2>
          <div class="check-row" style="margin-bottom:.5rem">
            <input id="wholesale" type="checkbox" />
            <label for="wholesale" style="font-weight:700">Precio mayorista</label>
          </div>
          <div class="form-group" id="wsGroup" hidden>
            <label for="wsDiscount">Descuento general %</label>
            <input id="wsDiscount" type="number" min="0" max="90" step="1" />
            <span class="hint">Se usa el precio mayorista de cada producto; si no tiene, el precio normal menos este %.</span>
          </div>
          <div class="form-group"><label for="delivery">Tiempo de elaboración</label><input id="delivery" type="text" maxlength="80" /></div>
          <div class="form-group"><label for="shipping">Valor del envío (0 = por calcular)</label><input id="shipping" type="number" min="0" step="1000" /></div>
          <div class="form-group"><label for="notes">Observaciones</label><textarea id="notes" rows="4" maxlength="1000"></textarea></div>
        </section>
      </form>

      <section class="preview" aria-label="Vista previa del PDF">
        <div class="eyebrow" style="margin-bottom:10px">Vista previa del PDF</div>
        <iframe id="preview" title="Vista previa de la cotización"></iframe>
      </section>
    </div>
  </div>

<script>
(function () {
  const CATALOG = <%- JSON.stringify(catalog).replace(/</g, '\\u003c') %>;
  const INITIAL = <%- JSON.stringify(quote).replace(/</g, '\\u003c') %>;
  let id = INITIAL ? INITIAL.id : null;
  const state = INITIAL ? {
    client: INITIAL.client, items: INITIAL.items, deliveryTime: INITIAL.deliveryTime, notes: INITIAL.notes, shipping: INITIAL.shipping,
    wholesale: !!INITIAL.wholesale, wholesaleDiscount: INITIAL.wholesaleDiscount || 0,
  } : {
    client: { name: '', city: '', phone: '' }, items: [], deliveryTime: '8 días hábiles', shipping: 0,
    wholesale: false, wholesaleDiscount: 0,
    notes: 'Cada pieza se teje a mano a pedido. La elaboración empieza una vez recibido el comprobante de pago.\nLos bolsos se empacan con cuidado para su entrega.',
  };

  const $ = (s) => document.getElementById(s);
  const money = (n) => '$' + Math.round(n).toLocaleString('es-CO');
  const esc = (s) => String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const thumb = (url, w) => url ? url.replace('/upload/', '/upload/w_' + w + ',h_' + w + ',c_fill,f_auto,q_auto/') : '';
  const msg = (text, type) => { $('msg').innerHTML = text ? '<div class="alert alert-' + (type || 'success') + '">' + esc(text) + '</div>' : ''; };

  // ── Formulario ↔ estado ──
  const bind = (el, get, set) => { el.value = get(); el.addEventListener('input', () => { set(el.value); changed(); }); };
  bind($('cName'), () => state.client.name, (v) => (state.client.name = v));
  bind($('cCity'), () => state.client.city, (v) => (state.client.city = v));
  bind($('cPhone'), () => state.client.phone, (v) => (state.client.phone = v));
  bind($('delivery'), () => state.deliveryTime, (v) => (state.deliveryTime = v));
  bind($('notes'), () => state.notes, (v) => (state.notes = v));
  bind($('shipping'), () => String(state.shipping || 0), (v) => (state.shipping = Math.max(0, Number(v) || 0)));
  $('search').addEventListener('input', renderChips);

  // ── Precio mayorista: precio del producto si existe; si no, normal − % ──
  function unitPrice(p) {
    if (!state.wholesale) return p.price;
    if (p.wholesalePrice != null) return p.wholesalePrice;
    return Math.round(p.price * (1 - (state.wholesaleDiscount || 0) / 100));
  }
  function repriceAll() {
    state.items.forEach((it) => {
      const p = CATALOG.find((x) => x.id === it.productId);
      if (!p) return;
      it.listPrice = p.price;
      it.price = unitPrice(p);
    });
    renderLines();
    changed();
  }
  $('wholesale').checked = state.wholesale;
  $('wsDiscount').value = String(state.wholesaleDiscount || 0);
  $('wsGroup').hidden = !state.wholesale;
  $('wholesale').addEventListener('change', (e) => {
    state.wholesale = e.target.checked;
    $('wsGroup').hidden = !state.wholesale;
    repriceAll();
  });
  $('wsDiscount').addEventListener('input', (e) => {
    state.wholesaleDiscount = Math.min(90, Math.max(0, Number(e.target.value) || 0));
    repriceAll();
  });

  function renderChips() {
    const q = $('search').value.trim().toLowerCase();
    $('chips').innerHTML = CATALOG.filter((p) => !q || p.name.toLowerCase().includes(q)).slice(0, 24).map((p) =>
      '<button type="button" data-add="' + p.id + '">' + (p.image ? '<img src="' + esc(thumb(p.image, 64)) + '" alt="" />' : '') + '+ ' + esc(p.name) + '</button>'
    ).join('');
  }

  function renderLines() {
    $('lines').innerHTML = state.items.map((it, i) =>
      '<div class="line">' +
        (it.image ? '<img src="' + esc(thumb(it.image, 88)) + '" alt="" />' : '<span class="ph"></span>') +
        '<div class="name">' + esc(it.name) +
          (it.listPrice && it.listPrice > it.price ? '<div class="hint" style="font-family:Lato,sans-serif;font-weight:400"><s>' + money(it.listPrice) + '</s> precio normal</div>' : '') +
        '</div>' +
        '<label class="sr" for="pr' + i + '" style="position:absolute;left:-9999px">Precio de ' + esc(it.name) + '</label>' +
        '<input class="price" id="pr' + i + '" type="number" min="0" step="1000" value="' + it.price + '" data-price="' + i + '" />' +
        '<div class="stepper"><button type="button" data-dec="' + i + '" aria-label="Disminuir cantidad">−</button><span>' + it.qty + '</span>' +
        '<button type="button" data-inc="' + i + '" aria-label="Aumentar cantidad">+</button></div>' +
      '</div>'
    ).join('') || '<p class="hint" style="padding:10px 0">Aún no hay productos.</p>';
    $('subtotal').textContent = money(state.items.reduce((s, i) => s + i.price * i.qty, 0));
  }

  document.addEventListener('click', (e) => {
    const t = e.target.closest('[data-add],[data-inc],[data-dec]');
    if (!t) return;
    if (t.dataset.add) {
      const p = CATALOG.find((x) => x.id === t.dataset.add);
      const line = state.items.find((x) => x.productId === p.id);
      if (line) line.qty++;
      else state.items.push({ productId: p.id, name: p.name, price: unitPrice(p), listPrice: p.price, qty: 1, image: p.image || undefined });
    } else if (t.dataset.inc) state.items[+t.dataset.inc].qty++;
    else {
      const i = +t.dataset.dec;
      if (--state.items[i].qty <= 0) state.items.splice(i, 1);
    }
    renderLines();
    changed();
  });
  document.addEventListener('input', (e) => {
    if (e.target.dataset && e.target.dataset.price !== undefined) {
      state.items[+e.target.dataset.price].price = Math.max(0, Number(e.target.value) || 0);
      $('subtotal').textContent = money(state.items.reduce((s, i) => s + i.price * i.qty, 0));
      changed();
    }
  });

  // ── Vista previa (PDF real, regenerado con retardo) ──
  let timer = null, lastUrl = null, seq = 0;
  function changed() { clearTimeout(timer); timer = setTimeout(refreshPreview, 500); }
  async function refreshPreview() {
    const mine = ++seq;
    const r = await fetch('/admin/quotes/preview' + (id ? '?id=' + id : ''), {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(state),
    });
    if (mine !== seq) return;
    if (!r.ok) { msg((await r.json()).message, 'error'); return; }
    msg('');
    const url = URL.createObjectURL(await r.blob());
    $('preview').src = url + '#toolbar=0&navpanes=0&view=FitH';
    if (lastUrl) URL.revokeObjectURL(lastUrl);
    lastUrl = url;
  }

  // ── Acciones ──
  async function save() {
    const r = await fetch('/admin/quotes' + (id ? '?id=' + id : ''), {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(state),
    });
    const body = await r.json();
    if (!r.ok) throw new Error(body.message);
    if (!id) history.replaceState(null, '', '/admin/quotes/' + body.data.id + '/edit');
    id = body.data.id;
    $('qnum').textContent = 'N.º ' + body.data.number;
    return body.data;
  }
  const busy = (btn, on) => { btn.disabled = on; btn.style.opacity = on ? .6 : 1; };

  $('btnSave').addEventListener('click', async (e) => {
    busy(e.currentTarget, true);
    try { const d = await save(); msg('Borrador N.º ' + d.number + ' guardado.'); refreshPreview(); }
    catch (err) { msg(err.message, 'error'); }
    busy(e.currentTarget, false);
  });

  $('btnPdf').addEventListener('click', async (e) => {
    busy(e.currentTarget, true);
    try { await save(); location.href = '/admin/quotes/' + id + '/pdf'; }
    catch (err) { msg(err.message, 'error'); }
    busy(e.currentTarget, false);
  });

  // Celular: compartir el archivo (adjunto real). Computador: wa.me con el enlace al PDF.
  const canShareFiles = !!(navigator.canShare && navigator.canShare({ files: [new File(['x'], 'x.pdf', { type: 'application/pdf' })] }));
  let shareData = null;
  $('btnSend').addEventListener('click', async (e) => {
    if (!state.client.phone) { msg('Escribe el celular del cliente para enviarle la cotización.', 'error'); $('cPhone').focus(); return; }
    const popup = canShareFiles ? null : window.open('', '_blank'); // abrir ya, para que no lo bloquee el navegador
    busy(e.currentTarget, true);
    try {
      await save();
      const r = await fetch('/admin/quotes/' + id + '/send', { method: 'POST' });
      const body = await r.json();
      if (!r.ok) throw new Error(body.message);
      const d = body.data;
      $('lnkWa').href = d.waUrl;
      if (popup) {
        popup.location = d.waUrl;
        msg('Cotización enviada: se abrió WhatsApp con el enlace al PDF.');
      } else {
        const blob = await (await fetch('/admin/quotes/' + id + '/pdf')).blob();
        shareData = { files: [new File([blob], d.filename, { type: 'application/pdf' })], text: d.text };
        $('sharePanel').style.display = 'block';
        $('btnShare').focus();
      }
      refreshPreview();
    } catch (err) {
      if (popup) popup.close();
      msg(err.message, 'error');
    }
    busy(e.currentTarget, false);
  });
  $('btnShare').addEventListener('click', async () => {
    try { await navigator.share(shareData); } catch (_) { /* cancelado */ }
  });

  renderChips();
  renderLines();
  refreshPreview();
})();
</script>
</body>
</html>
