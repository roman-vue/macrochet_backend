<!DOCTYPE html>
<html lang="es">
<head><%- include('../../partials/head', { title: 'Nuevo producto' }) %></head>
<body>
  <%- include('../../partials/nav', { path: '/admin/products/create' }) %>
  <div class="page">
    <h1>Nuevo producto</h1>
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="alert alert-success"><%= success %></div>
    <% } %>
    <div class="card">
      <form method="POST" action="/admin/products" enctype="multipart/form-data">

        <div class="form-group">
          <label>Nombre *</label>
          <input type="text" name="name" required />
        </div>

        <div class="form-group">
          <label>Descripción *</label>
          <textarea name="description" required></textarea>
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem">
          <div class="form-group">
            <label>Precio *</label>
            <input type="number" name="price" min="0" step="0.01" required />
          </div>
          <div class="form-group">
            <label>Stock</label>
            <input type="number" name="stock" min="0" value="0" />
          </div>
        </div>

        <div class="form-group">
          <label>Categoría *</label>
          <input type="text" name="category" list="cat-list" required placeholder="Ej: Vestidos" />
          <datalist id="cat-list">
            <% categories.forEach(c => { %><option value="<%= c %>"><% }) %>
          </datalist>
          <span class="hint">Escribe una existente o crea una nueva.</span>
        </div>

        <div class="form-group">
          <label>Colores</label>
          <div style="display:flex;flex-wrap:wrap;gap:.6rem;padding:.5rem 0">
            <% colors.forEach(c => { %>
              <label style="display:flex;align-items:center;gap:.4rem;font-size:.875rem;cursor:pointer">
                <input type="checkbox" name="colors" value="<%= c._id %>" />
                <span class="swatch" style="background:<%= c.hex %>"></span>
                <%= c.name %>
              </label>
            <% }) %>
          </div>
          <% if (!colors.length) { %><span class="hint">No hay colores registrados aún.</span><% } %>
        </div>

        <div class="form-group">
          <label>¿Bestseller?</label>
          <div class="check-row">
            <input type="checkbox" name="isBestseller" id="bs" value="true" />
            <label for="bs" style="text-transform:none;letter-spacing:0;font-size:.9rem;color:#333">Marcar como bestseller</label>
          </div>
        </div>

        <div class="form-group">
          <label>Imágenes</label>
          <input type="file" name="images" multiple accept="image/jpeg,image/jpg,image/png,image/webp,image/gif" />
          <span class="hint">Máx. 10 imágenes · 5 MB cada una · jpeg, png, webp, gif</span>
        </div>

        <button class="btn btn-primary" type="submit">Crear producto</button>
      </form>
    </div>
  </div>
</body>
</html>
