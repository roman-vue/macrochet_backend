<!DOCTYPE html>
<html lang="es">
<head><%- include('../../partials/head', { title: 'Productos' }) %></head>
<body>
  <%- include('../../partials/nav', { path: '/admin/products' }) %>
  <div class="page">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1.5rem">
      <h1 style="margin:0">Productos (<%= products.length %>)</h1>
      <a class="btn btn-primary" href="/admin/products/create">+ Nuevo</a>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="alert alert-success"><%= success %></div>
    <% } %>

    <% if (!products.length) { %>
      <div class="card" style="text-align:center;padding:3rem;color:#888">
        No hay productos todavía. <a href="/admin/products/create" style="color:#1a1a1a;font-weight:500">Crear el primero</a>
      </div>
    <% } else { %>
      <div class="card" style="padding:0;overflow:hidden">
        <table>
          <thead>
            <tr>
              <th>Imagen</th>
              <th>Nombre</th>
              <th>Categoría</th>
              <th>Precio</th>
              <th>Stock</th>
              <th style="text-align:center">Bestseller</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% products.forEach(p => { %>
            <tr>
              <td style="width:56px">
                <% if (p.images && p.images.length) { %>
                  <img src="<%= p.images[0] %>" style="width:44px;height:44px;object-fit:cover;border-radius:6px;border:1px solid #eee" />
                <% } else { %>
                  <div style="width:44px;height:44px;background:#f0f0f0;border-radius:6px;display:flex;align-items:center;justify-content:center;font-size:.7rem;color:#aaa">sin img</div>
                <% } %>
              </td>
              <td style="font-weight:500"><%= p.name %></td>
              <td style="color:#666"><%= p.category %></td>
              <td>$<%= p.price.toFixed(2) %></td>

              <!-- stock inline edit -->
              <td style="width:130px">
                <form method="POST" action="/admin/products/<%= p._id %>/stock" style="margin:0;display:flex;gap:.4rem">
                  <input type="number" name="stock" value="<%= p.stock %>" min="0"
                    style="width:64px;padding:.3rem .5rem;border:1px solid #d4d4d4;border-radius:6px;font-size:.85rem;font-family:inherit" />
                  <button class="btn btn-sm" style="background:#f5f5f5;border:1px solid #d4d4d4" type="submit">✓</button>
                </form>
              </td>

              <!-- bestseller toggle -->
              <td style="text-align:center;width:100px">
                <form method="POST" action="/admin/products/<%= p._id %>/bestseller" style="margin:0">
                  <button type="submit" style="background:none;border:none;cursor:pointer;font-size:1.2rem;line-height:1"
                    title="<%= p.isBestseller ? 'Quitar bestseller' : 'Marcar bestseller' %>">
                    <%= p.isBestseller ? '★' : '☆' %>
                  </button>
                </form>
              </td>

              <td style="width:120px">
                <div style="display:flex;gap:.4rem">
                  <a class="btn btn-sm" style="background:#f5f5f5;border:1px solid #e5e5e5"
                    href="/admin/products/<%= p._id %>/edit">Editar</a>
                  <form method="POST" action="/admin/products/<%= p._id %>/delete" style="margin:0">
                    <button class="btn btn-sm" style="background:#fef2f2;border:1px solid #fca5a5;color:#b91c1c" type="submit"
                      onclick="return confirm('¿Eliminar <%= p.name %>?')">✕</button>
                  </form>
                </div>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</body>
</html>
